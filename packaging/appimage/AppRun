set -eu

if [ -z "${APPDIR:-}" ]; then
    APPDIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
fi

export JAMELADE_SIDECAR="$APPDIR/usr/share/jamelade/sidecar"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

loader_dir="$APPDIR/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders"
if [ -d "$loader_dir" ]; then
    : "${HOME:?Jamelade AppImage requires HOME}"
    cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/jamelade"
    cache_file="$cache_dir/appimage-gdk-pixbuf.loaders"
    temporary="$cache_file.$$"
    umask 077
    mkdir -p "$cache_dir"
    "$APPDIR/usr/bin/gdk-pixbuf-query-loaders" "$loader_dir"/*.so >"$temporary"
    mv -f "$temporary" "$cache_file"
    export GDK_PIXBUF_MODULEDIR="$loader_dir"
    export GDK_PIXBUF_MODULE_FILE="$cache_file"
fi

# Electron receives no sandbox-disabling argument. Systems that prohibit both
# Chromium sandbox mechanisms fail closed rather than running the Apple session
# without its renderer sandbox.
exec "$APPDIR/usr/bin/jamelade" "$@"
