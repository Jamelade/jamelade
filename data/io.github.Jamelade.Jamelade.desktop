[Desktop Entry]
Type=Application
Name=Jamelade
GenericName=Music Player
Comment=Play your Apple Music library natively on Linux
Exec=jamelade
Icon=io.github.Jamelade.Jamelade
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=Music;Apple;Player;Audio;Playlist;Streaming;
StartupNotify=true
# The visible, portal-replaceable entry is the `.Launcher` sub-id. Keep this
# canonical app-id entry for Flatpak/AppStream identity and old pinned launchers
# without showing a second Jamelade tile in application menus.
NoDisplay=true
# The Wayland app_id, which GTK takes from the application id and not from the
# binary name. GNOME matches on this file's own id and never reads the line, so
# the old binary name looked right there while every wlroots-style bar and
# taskbar failed to tie the window to this entry.
StartupWMClass=io.github.Jamelade.Jamelade
