/target
/icon-helper/target
/sidecar/node_modules

# Local developer configuration and credential material never belongs in a
# source revision. The Discord Application ID is public, but developers may
# keep unrelated account values in the same local environment file.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
apple-session.vault
Cookies
Cookies-journal

# makepkg build output. The PKGBUILDs are source; everything makepkg creates
# beside them is not — including the ~330 MB it downloads.
/packaging/aur/*/src/
/packaging/aur/*/pkg/
/packaging/aur/*/*.pkg.tar.*
/packaging/aur/*/*.tar.gz
/packaging/aur/*/.SRCINFO
# The bare clone a -git PKGBUILD's source=('git+…') leaves behind. Named after
# the package rather than living under src/, so the rules above miss it.
/packaging/aur/*/slipmat/

# Flatpak build output
build-dir/
flatpak-repo/
release-repo/
dist/
.jamelade-repro-*/
.flatpak-builder/
.broker-test-build/
.broker-test-repo/
.stable-promotion-build/
.stable-promotion-repo/
.stable-verify-build/
.stable-verify-repo/
.audit-cargo-home/
.audit-target/
.audit-tools/
.payload-audit/
.test-pkgconfig/

# fetched on demand by packaging/flatpak/generate-sources.sh
packaging/flatpak/.flatpak-cargo-generator.py
# Any bundle, not one spelled-out name. A named entry was renamed along with
# the app once, which un-ignored the 94 MB artefact it had been protecting and
# a `git add -A` committed it on the spot.
*.flatpak

CLAUDE.md
